# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-electron/
out/
release/
*.tsbuildinfo

# NOTE: build/ is NOT ignored. Despite the name it is electron-builder's
# `buildResources` directory — icons and entitlements, which are SOURCE.
# Ignoring it meant the icons never reached CI: macOS silently fell back to the
# default Electron icon and the Windows NSIS build failed outright on a missing
# installerIcon. Build OUTPUT goes to release/.

# Bundled sound assets (downloaded by scripts/fetch-assets.mjs)
resources/audio/samples/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env & secrets
.env
.env.*
!.env.example
*.p12
*.mobileprovision
build/entitlements.local.plist

# Test / coverage
coverage/
.nyc_output/
playwright-report/
test-results/
